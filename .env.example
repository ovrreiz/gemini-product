# Скопіюйте ці рядки в термінал (export ...) або передайте їх як змінні середовища. НЕ комітьте реальні ключі!
GEMINI_API_KEY=your-key-from-google-ai-studio
# Моделі через кому: перша — основна, решта — запасні (на випадок 404/429). Актуальні назви: python scripts/check_api.py
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash
MAX_REQUESTS_PER_SESSION=20
# APP_PASSWORD=optional-password-for-the-web-ui
# MOCK=1   # примусовий демо-режим без API
